<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <BuildNumberFile>$(MSBuildProjectDirectory)\build-number.txt</BuildNumberFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AiVideoClassifier.cs" Link="Services\AiVideoClassifier.cs" />
    <Compile Include="..\Shared\AiVideoKeywords.cs" Link="Services\AiVideoKeywords.cs" />
    <Compile Include="..\Shared\JsonFileStore.cs" Link="Services\JsonFileStore.cs" />
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.77.0.4302" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <None Include="client_secret.json" Condition="Exists('client_secret.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EmbeddedResource Include="client_secret.json" Condition="Exists('client_secret.json')" LogicalName="YouTubePlayer.client_secret.json" />
    <None Update="client_secret.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="IncrementBuildNumber" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_CurrentBuildNumber>$([System.IO.File]::ReadAllText('$(BuildNumberFile)').Trim())</_CurrentBuildNumber>
      <_NextBuildNumber Condition="'$(DesignTimeBuild)' == 'true'">$(_CurrentBuildNumber)</_NextBuildNumber>
      <_NextBuildNumber Condition="'$(DesignTimeBuild)' != 'true'">$([MSBuild]::Add($(_CurrentBuildNumber), 1))</_NextBuildNumber>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Lines="namespace YouTubePlayer { internal static class BuildInfo { internal const int Number = $(_NextBuildNumber)%3B } }" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

  <Target Name="SaveBuildNumber" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(_NextBuildNumber)" Overwrite="true" />
  </Target>

</Project>
