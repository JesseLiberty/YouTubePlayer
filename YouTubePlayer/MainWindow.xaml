<Window x:Class="YouTubePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:YouTubePlayer.Models"
        Title="YouTube Player" Height="850" Width="1400"
        WindowStartupLocation="CenterScreen" Background="#181818">
    <Window.Resources>
        <Style x:Key="VideoCardStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="#2C2C2C" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#202020" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SyncButton" Content="Sync" Width="100" Padding="4" Click="SyncButton_Click" />
                <TextBlock x:Name="StatusText" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Horizontal scroll across columns; each column scrolls vertically on its own. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SeriesItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SeriesColumn}">
                        <Border Width="320" Margin="6" Background="#232323" CornerRadius="4">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="8">
                                    <Button DockPanel.Dock="Right" Content="Unsubscribe" Padding="6,2"
                                            Tag="{Binding}" Click="Unsubscribe_Click" />
                                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontWeight="Bold" FontSize="14"
                                               Foreground="White" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,8">
                                    <ItemsControl ItemsSource="{Binding Videos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:VideoItem}">
                                                <Button Style="{StaticResource VideoCardStyle}" Tag="{Binding}" Click="Video_Click">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding PublishedAt, StringFormat={}{0:MMM d, yyyy}}"
                                                                   Foreground="#AAAAAA" FontSize="11" Margin="0,2,0,4" />
                                                        <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}"
                                                                   Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"
                                                                   TextTrimming="WordEllipsis" MaxHeight="64" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
