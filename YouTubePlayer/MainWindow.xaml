<Window x:Class="YouTubePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:YouTubePlayer.Models"
        Title="YouTube Player - &#x00A9; 2026 Jesse Liberty" Height="850" Width="1400"
        WindowStartupLocation="CenterScreen" Background="#181818">
    <Window.Resources>
        <Style TargetType="{x:Type ScrollBar}">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="#F0F0F0" Height="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarHeightKey}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RepeatButton Width="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}"
                                                  Command="{x:Static ScrollBar.LineLeftCommand}" Content="&#x25C0;" FontSize="9" Padding="0" Focusable="False" />
                                    <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal">
                                        <Track.Resources>
                                            <Style TargetType="{x:Type RepeatButton}">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                            <Border Background="Transparent" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Track.Resources>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb MinWidth="17">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="ThumbBorder" Background="#707070" />
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#555555" />
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#404040" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                    <RepeatButton Grid.Column="2" Width="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}"
                                                  Command="{x:Static ScrollBar.LineRightCommand}" Content="&#x25B6;" FontSize="9" Padding="0" Focusable="False" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VideoCardStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="#2C2C2C" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearchMatch}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
        <Border DockPanel.Dock="Top" Background="#202020" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="HelpButton" Content="Help" Width="100" Padding="4" Background="#FFD54F"
                        Foreground="Black" Margin="0,0,8,0" Click="HelpButton_Click" />
                <Button x:Name="SyncButton" Content="Sync" Width="100" Padding="4" Background="#4CAF50"
                        Foreground="Black" Click="SyncButton_Click" />
                <Button x:Name="UndoButton" Content="Undo" Width="100" Padding="4" Margin="8,0,0,0"
                    Background="#FFD54F" Foreground="Black" Visibility="Collapsed" Click="UndoButton_Click" />
                <TextBlock Text="Search:" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox x:Name="SearchBox" Width="240" Padding="4" VerticalContentAlignment="Center"
                         Background="#333333" Foreground="White" BorderBrush="#666666"
                         ToolTip="Search video titles and summaries" TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="StatusText" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Horizontal scroll across columns; each column scrolls vertically on its own. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SeriesItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SeriesColumn}">
                        <Border Width="320" Margin="6" Background="#232323" CornerRadius="4"
                            AllowDrop="True" DragOver="Column_DragOver" Drop="Column_Drop">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="8" Background="Transparent"
                                           PreviewMouseLeftButtonDown="ColumnHeader_PreviewMouseLeftButtonDown"
                                           MouseMove="ColumnHeader_MouseMove">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="ToolTip" Value="Drag to reorder" />
                                            <Setter Property="Cursor" Value="SizeAll" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImportantColumn}" Value="True">
                                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <Button DockPanel.Dock="Right" Content="Unsubscribe" Padding="6,2"
                                            Tag="{Binding}" Click="Unsubscribe_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsImportantColumn}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"
                                               Foreground="White" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsImportantColumn}" Value="True" />
                                                            <Condition Binding="{Binding Videos.Count}" Value="0" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,8">
                                    <ItemsControl ItemsSource="{Binding Videos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:VideoItem}">
                                                <Button Style="{StaticResource VideoCardStyle}" Tag="{Binding}" ToolTip="Drag to reorder within this column"
                                                    AllowDrop="True" PreviewMouseLeftButtonDown="Video_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="Video_MouseMove" DragOver="Video_DragOver" Drop="Video_Drop"
                                                    Click="Video_Click"
                                                    MouseDoubleClick="Video_MouseDoubleClick"
                                                    PreviewMouseRightButtonDown="Video_PreviewMouseRightButtonDown">
                                                    <DockPanel>
                                                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="&#x2715;"
                                                            Width="22" Height="22" Margin="6,0,0,0" Padding="0"
                                                            ToolTip="Remove from list" Tag="{Binding}" Click="RemoveVideo_Click" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                            <TextBlock Text="{Binding DateAndLength}" Foreground="#AAAAAA" FontSize="11" />
                                                            <TextBlock Text="{Binding WatchMark}" Foreground="#4CAF50" FontSize="11" FontWeight="Bold"
                                                                       Margin="6,0,0,0" ToolTip="{Binding WatchToolTip}" />
                                                            <TextBlock Text="{Binding AiMark}" Foreground="#FFD54F" FontSize="11" FontWeight="Bold"
                                                                       Margin="6,0,0,0" ToolTip="AI keyword match or model-estimated probability above 80%" />
                                                            <TextBlock Text="{Binding ImportantMark}" Foreground="#FFD54F" FontSize="12" FontWeight="Bold"
                                                                       Margin="6,0,0,0" ToolTip="Important video" />
                                                            <TextBlock Text="{Binding NewMark}" Foreground="#FFD54F" FontSize="12" FontWeight="Bold"
                                                                       Margin="6,0,0,0" ToolTip="New video" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"
                                                                   TextTrimming="WordEllipsis" MaxHeight="64" />
                                                    </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
        <Border x:Name="DetailsPane" Grid.Column="1" Background="#E6E6E6" Padding="16"
            BorderBrush="#BDBDBD" BorderThickness="1,0,0,0"
                PreviewMouseRightButtonDown="Details_PreviewMouseRightButtonDown"
                PreviewMouseLeftButtonDown="Details_PreviewMouseLeftButtonDown">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext, ElementName=DetailsPane}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#202A35" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding PublishedDate}" Foreground="#526273" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding NewMark}" Foreground="#9A6700" FontWeight="Bold" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding WatchMark}" Foreground="#2E7D32" FontWeight="Bold" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding PlaybackTime}" Foreground="#526273" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ImportantMark}" Foreground="#9A6700" FontWeight="Bold" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Chapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:VideoChapter}">
                                    <Button Click="Chapter_Click" Cursor="Hand" Margin="0,0,0,6" Padding="6"
                                            HorizontalContentAlignment="Stretch" Background="#2C2C2C" Foreground="White"
                                            BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Timestamp}" Foreground="#80CBC4" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding DetailsDescription}" Foreground="#34495E" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="Details about your video will appear here when you single-click on a video card."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="#526273" Margin="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext, ElementName=DetailsPane}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
