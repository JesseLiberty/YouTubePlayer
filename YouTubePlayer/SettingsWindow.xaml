<Window x:Class="YouTubePlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="360" Height="180" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#202020">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Label Content="Frequency" Target="{Binding ElementName=FrequencyBox}"
                   Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="FrequencyBox" Width="180" VerticalContentAlignment="Center"
                      SelectedValuePath="Tag" />
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Row="2" Content="Save" Width="80" Padding="4"
                HorizontalAlignment="Right" IsDefault="True" Click="CloseButton_Click" />
    </Grid>
</Window>
