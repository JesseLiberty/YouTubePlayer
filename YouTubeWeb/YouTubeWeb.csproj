<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AiVideoClassifier.cs" Link="Services\AiVideoClassifier.cs" />
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.77.0.4302" />
  </ItemGroup>

  <!-- Reuse the WPF app's Google OAuth desktop client unless this project has its own. -->
  <ItemGroup>
    <None Include="client_secret.json" Condition="Exists('client_secret.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\YouTubePlayer\client_secret.json" Link="client_secret.json" Condition="!Exists('client_secret.json') And Exists('..\YouTubePlayer\client_secret.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
