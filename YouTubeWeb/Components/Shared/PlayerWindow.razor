@* Replaces the WPF modal PlayerWindow: a maximized, window-like overlay hosting the YouTube player. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (_session is { } session)
{
    <div class="player-window" tabindex="-1" @ref="_window" @onkeydown="OnKeyDown" @oncontextmenu:preventDefault>
        <div class="window-title-bar">
            <span class="window-title">@session.Title</span>
            <button class="window-close player-close" title="Close (Esc)" @onclick="Close">&#x2715;</button>
        </div>
        <div class="player-host" @ref="_host"></div>
    </div>
}

@code {
    private Session? _session;
    private ElementReference _window;
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _player;
    private DotNetObjectReference<PlayerWindow>? _self;
    private bool _startPending;

    /// <summary>Plays a video and completes when it ends or the player is closed.</summary>
    public Task<PlayerResult> PlayAsync(string videoId, string title, int startPositionSeconds)
    {
        _session?.Completion.TrySetResult(new PlayerResult(_session.WatchLevel, _session.PositionSeconds));
        _session = new Session(videoId, title, startPositionSeconds);
        _startPending = true;
        StateHasChanged();
        return _session.Completion.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_startPending || _session is not { } session) return;
        _startPending = false;

        await _window.FocusAsync();
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/player.js");
        _self ??= DotNetObjectReference.Create(this);
        var player = await _module.InvokeAsync<IJSObjectReference>(
            "open", _host, session.VideoId, session.StartPositionSeconds, _self);

        if (ReferenceEquals(_session, session))
            _player = player;
        else
            await DisposePlayerAsync(player);
    }

    [JSInvokable]
    public void OnPosition(int positionSeconds)
    {
        if (_session is { } session) session.PositionSeconds = positionSeconds;
    }

    [JSInvokable]
    public void OnStarted()
    {
        if (_session is { WatchLevel: < WatchLevel.Started } session) session.WatchLevel = WatchLevel.Started;
    }

    [JSInvokable]
    public void OnWatched()
    {
        if (_session is { } session) session.WatchLevel = WatchLevel.Watched;
    }

    [JSInvokable]
    public async Task OnEnded(int durationSeconds)
    {
        if (_session is { } session && durationSeconds >= 0) session.PositionSeconds = durationSeconds;
        await Close();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }

    private async Task Close()
    {
        if (_session is not { } session) return;

        _session = null;
        var player = _player;
        _player = null;
        StateHasChanged();
        await DisposePlayerAsync(player);
        session.Completion.TrySetResult(new PlayerResult(session.WatchLevel, session.PositionSeconds));
    }

    private static async Task DisposePlayerAsync(IJSObjectReference? player)
    {
        if (player is null) return;
        try
        {
            await player.InvokeVoidAsync("dispose");
            await player.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _session?.Completion.TrySetResult(new PlayerResult(_session.WatchLevel, _session.PositionSeconds));
        await DisposePlayerAsync(_player);
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }

    private sealed class Session(string videoId, string title, int startPositionSeconds)
    {
        public string VideoId { get; } = videoId;
        public string Title { get; } = title;
        public int StartPositionSeconds { get; } = startPositionSeconds;
        public WatchLevel WatchLevel { get; set; }
        public int? PositionSeconds { get; set; }
        public TaskCompletionSource<PlayerResult> Completion { get; } =
            new(TaskCreationOptions.RunContinuationsAsynchronously);
    }
}
